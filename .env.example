# Set a unique long password before exposing the WebUI.
NEGADOWNLOADER_PASSWORD=change-this-to-a-long-random-password
NEGADOWNLOADER_COOKIE_SECURE=false

# Host directories mapped into the container as /app/data and /app/download.
NEGADOWNLOADER_CONFIG=./data/config
NEGADOWNLOADER_DOWNLOADS=./downloads

# Optional: host port for the WebUI.
NEGADOWNLOADER_PORT=20880

# Unraid default user/group. Set to the UID/GID that owns the host folders.
PUID=99
PGID=100

# Keep enabled unless Chromium cannot start on this host.
NEGADOWNLOADER_CHROMIUM_SANDBOX=true

# Maximum time per download, in seconds (default: 6 hours).
NEGADOWNLOADER_DOWNLOAD_TIMEOUT_SECONDS=21600
